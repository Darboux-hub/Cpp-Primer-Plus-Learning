{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ (Windows) 自动调试当前文件",
            "type": "cppvsdbg",
            "request": "launch",
            // 关键点：动态指向当前文件夹下的同名 exe
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}", // 工作目录设为当前代码所在文件夹
            "environment": [],
            "console": "integratedTerminal", // 使用集成终端（不用弹窗）
            
            // 关键点：调试前先执行 tasks.json 里的编译任务
            "preLaunchTask": "C/C++: cl.exe build active file"
        }
    ]
}